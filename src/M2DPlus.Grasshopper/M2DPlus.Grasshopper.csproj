<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0-windows is the unchanged Windows build (win Yak). net8.0 is the mac Yak build: Rhino for Mac
         supplies its own System.Windows.Forms/System.Drawing, so no desktop framework is referenced or bundled. -->
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <UseWindowsForms Condition="'$(TargetFramework)' == 'net8.0-windows'">true</UseWindowsForms>
    <TargetExt>.gha</TargetExt>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../M2DPlus.Core/M2DPlus.Core.csproj" />
    <ProjectReference Include="../M2DPlus.Rhino/M2DPlus.Rhino.csproj" />
    <PackageReference Include="Grasshopper" Version="$(RhinoApiVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="RhinoCommon" Version="$(RhinoApiVersion)" ExcludeAssets="runtime" />
    <Reference Update="Grasshopper;GH_IO;RhinoCommon"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
